@model SalonFryzjerski.Models.Appointment

@{
    ViewData["Title"] = "Create";
    var minStart = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");

}

<h1>Create</h1>

<h4>Appointment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ServiceId" class="control-label"></label>
                <select asp-for="ServiceId" class="form-control" asp-items="ViewBag.ServiceId">
                    <option value="">-- wybierz usługę --</option>
                </select>
                <span asp-validation-for="ServiceId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EmployeeId" class="control-label"></label>
                <select asp-for="EmployeeId" class="form-control" asp-items="ViewBag.EmployeeId">
                    <option value="">-- wybierz fryzjera --</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartAt" class="control-label"></label>
                <input class="form-control"
                       type="datetime-local"
                       name="StartAt"
                       value="@(Model?.StartAt == default ? "" : Model.StartAt.ToString("yyyy-MM-ddTHH:mm"))"
                       min="@minStart" />
            </div>
                <span asp-validation-for="StartAt" class="text-danger"></span>
                <div class="form-group">
                    <label asp-for="ClientName" class="control-label">Osoba</label>
                    <input asp-for="ClientName" class="form-control" />
                    <span asp-validation-for="ClientName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Note" class="control-label">Komentarz</label>
                    <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>


            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
