@model IEnumerable<SalonFryzjerski.Models.Appointment>
@using SalonFryzjerski.Models


@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Service)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employee)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Service.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Employee.FirstName)
            </td>
            <td>
                    @item.StartAt.ToString("dd.MM.yyyy HH:mm")

            </td>
            <td>
                    @item.EndAt.ToString("dd.MM.yyyy HH:mm")

            </td>
                @{
                    var statusClass = item.Status switch
                    {
                        AppointmentStatus.Planned => "bg-primary",
                        AppointmentStatus.Done => "bg-success",
                        AppointmentStatus.Cancelled => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <td>
                    <span class="badge @statusClass">@item.Status</span>
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
