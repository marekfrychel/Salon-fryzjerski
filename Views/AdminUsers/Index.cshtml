@model List<SalonFryzjerski.Models.AdminUserListItemVm>

@{
    ViewData["Title"] = "Użytkownicy";
}

<h2>Użytkownicy</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>UserName</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.UserName</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@u.UserId">Uprawnienia</a>
                </td>
            </tr>
        }
    </tbody>
</table>
